# Copy to config/cluster.env (local only) and edit paths for the destination.
# Model weights and dataset caches must be mounted/copied separately.
# User-corrected A2 image for new 910B tasks; verify actual CANN/ops after creation.
export NPU_JOB_IMAGE="${NPU_JOB_IMAGE:-registry2.d.pjlab.org.cn/ccr-lepton-official-images/a2-cann:9.1.0-a2-ubuntu22.04-py3.12}"
# Clone DeepLink-org/LiteGen.dev separately; pin config/litegen.lock.json's commit.
# Default: ../LiteGen.dev relative to this project's root.
# export LITEGEN_ROOT=/your/workspace/LiteGen.dev
export OSS_ROOT="${OSS_ROOT:-/oss}"
export EDGE_DROID_MODEL_PATH="${EDGE_DROID_MODEL_PATH:-$OSS_ROOT/shichaojian/models/cosmos3-edge-droid}"
export BASE_CHECKPOINT_PATH="${BASE_CHECKPOINT_PATH:-$OSS_ROOT/shichaojian/models/cosmos3-edge-droid-dcp}"
export WAN_VAE_PATH="${WAN_VAE_PATH:-$EDGE_DROID_MODEL_PATH/vae/Wan2.2_VAE.pth}"
export SIM_POINTFK_BUNDLE="${SIM_POINTFK_BUNDLE:-$OSS_ROOT/shichaojian/wam_datasets_20261029/sim_task27_ball_wam}"

# Native ARM Python 3.12 from the task image. Change if installed elsewhere.
export NPU_BOOTSTRAP_PYTHON="${NPU_BOOTSTRAP_PYTHON:-/usr/local/python3.12.13/bin/python3.12}"
# Local per-node installation; recreate after container replacement/path moves.
# For a prebuilt shared venv, set its final absolute path; see docs/shared_environment.md.
export COSMOS_NPU_ENV="${COSMOS_NPU_ENV:-/tmp/cosmos-training-litegen-910b-env}"
# If omitted, activate.sh searches the standard CANN installation paths.
# export CANN_ENV=/usr/local/Ascend/cann/set_env.sh

# Optional: keep the full smoke checkpoint; directory MUST NOT already exist.
# Without this option, temporary smoke weights are removed after verification.
# Require >=40 GiB free; use a persistent output volume to retain the checkpoint.
# export NPU_WAM_OUTPUT_ROOT=/your/persistent/volume/outputs/new-smoke-directory
# export NPU_SCRATCH_ROOT=/your/local/scratch

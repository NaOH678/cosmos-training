# Copy to train.env on each node. Environment values override these defaults.
# Platform SENSECORE_* aliases are also accepted when these variables are unset.
export NNODES="${NNODES:-${SENSECORE_PYTORCH_NNODES:-1}}"
export NPROC_PER_NODE="${NPROC_PER_NODE:-${SENSECORE_ACCELERATE_DEVICE_COUNT:-8}}"
# Multi-node jobs MUST set a distinct NODE_RANK on each node (0 .. NNODES-1).
# export NODE_RANK=0
# All nodes must use the same reachable node-0 address, port and shared output.
# export MASTER_ADDR=10.0.0.10
export MASTER_PORT="${MASTER_PORT:-29644}"
# export OUTPUT_ROOT=/shared/outputs/wam-32card-run01

# Training defaults: global batch 128, accumulation 1, 5000 steps, LR cycle 40000.
# Per-rank batch is inferred: 8 cards -> 16; 16 -> 8; 32 -> 4.
# --smoke defaults to 2 steps, batch 1/rank, no validation. Optional overrides:
# export GLOBAL_BATCH_SIZE=128
# export GRAD_ACCUM_ITER=1
# export MAX_ITER=5000 SAVE_ITER=5000
# export CYCLE_LENGTH=40000
# BATCH_SIZE may still be set explicitly; if GLOBAL_BATCH_SIZE is also set,
# they must agree. Use a fresh OUTPUT_ROOT when changing topology or batch.

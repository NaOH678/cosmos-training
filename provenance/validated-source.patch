+class _PortableMetadataUnpickler(pickle.Unpickler):
+    def find_class(self, module, name):
+        # Python 3.13+ moved concrete pathlib classes into pathlib._local.
+        # Older trusted DCP exports must remain readable on the pinned 3.12 image.
+        if module == "pathlib._local" and name in {"Path", "PosixPath", "WindowsPath"}:
+            module = "pathlib"
+        return super().find_class(module, name)
+
+
+class PortableFileSystemReader(FileSystemReader):
+    """Read DCP metadata across Python pathlib layout changes without rewriting it."""
+
+    def read_metadata(self, *args, **kwargs):
+        path = self._get_metadata_path(kwargs.get("rank"))
+        with self.fs.create_stream(path, "rb") as stream:
+            metadata = _PortableMetadataUnpickler(stream).load()
+        if getattr(metadata, "storage_meta", None) is None:
+            metadata.storage_meta = StorageMeta()
+        metadata.storage_meta.load_id = self.load_id
+        return metadata
+
